--indent-columns=3
--continuation-indentation=3
--maximum-line-length=100
--cuddled-else
--no-outdent-long-lines
--paren-tightness=2
--square-bracket-tightness=2
--brace-tightness=2
--block-brace-tightness=0
--vertical-tightness=2
--space-after-keyword="for foreach if elsif unless while until and or err"
--nooutdent-labels
--swallow-optional-blank-lines
